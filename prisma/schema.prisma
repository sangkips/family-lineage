// Family Tree schema — see PLAN.md §3 for the data model rationale.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PersonStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ParentRole {
  FATHER
  MOTHER
  PARENT
  GUARDIAN
}

enum UserRole {
  ADMIN
  MEMBER
}

/// How much of a date was actually known. Ancestors are usually remembered by
/// year alone, and storing 1948-01-01 without this would invent a precision
/// nobody gave us.
enum DatePrecision {
  YEAR
  MONTH
  DAY
}

/// One row per person in the tree.
model Person {
  id         String       @id @default(cuid())
  firstName  String
  lastName   String
  maidenName String?
  gender     Gender?
  birthDate  DateTime?
  birthDatePrecision DatePrecision @default(DAY)
  birthPlace String?
  deathDate  DateTime?
  deathPlace String?
  photoUrl   String?
  bio        String?
  isLiving   Boolean      @default(true)
  /// Privacy toggles for living members: hide birth date / full name from
  /// non-admin visitors. Only meaningful when isLiving is true.
  hideBirthDate Boolean     @default(false)
  hideFullName  Boolean     @default(false)
  status     PersonStatus @default(PENDING)
  /// Supabase Auth user id of the submitter
  createdBy  String?
  /// Soft delete for rejected entries (keeps an audit trail)
  deletedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  parents  PersonParent[] @relation("parentChild")
  children PersonParent[] @relation("childParent")
  profile  Profile?
  edits    PendingEdit[]

  marriagesAsA Marriage[] @relation("marriagePartnerA")
  marriagesAsB Marriage[] @relation("marriagePartnerB")

  @@index([lastName, firstName])
  @@index([status])
}

/// Parent ↔ child links. A person can have up to two parents (father + mother)
/// and any number of children — the whole tree is a directed acyclic graph.
model PersonParent {
  id        String     @id @default(cuid())
  childId   String
  parentId  String
  role      ParentRole @default(PARENT)
  createdAt DateTime   @default(now())

  child  Person @relation("parentChild", fields: [childId], references: [id], onDelete: Cascade)
  parent Person @relation("childParent", fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([childId, parentId])
  @@index([parentId])
  @@index([childId])
}

/// A marriage between two people.
///
/// Until now a couple was only ever *inferred* from sharing a child, which
/// cannot represent a childless marriage, cannot say when it happened, and
/// cannot tell a marriage apart from co-parenting. A person may appear in
/// several marriages — remarriage after a death or divorce, and concurrent
/// marriages both fit.
///
/// The two partner ids are stored in sorted order so the unique constraint
/// catches a duplicate however the pair was entered.
model Marriage {
  id         String @id @default(cuid())
  partnerAId String
  partnerBId String

  startDate      DateTime?
  startPrecision DatePrecision @default(YEAR)
  endDate        DateTime?
  /// DIVORCE | DEATH — why it ended, when it has.
  endReason      String?

  /// Marriages go through the same review as everyone else.
  status    PersonStatus @default(PENDING)
  deletedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  partnerA Person        @relation("marriagePartnerA", fields: [partnerAId], references: [id], onDelete: Cascade)
  partnerB Person        @relation("marriagePartnerB", fields: [partnerBId], references: [id], onDelete: Cascade)
  edits    PendingEdit[]

  @@unique([partnerAId, partnerBId])
  @@index([partnerAId])
  @@index([partnerBId])
  @@index([status])
}

/// Links a Supabase Auth account to the Person node that represents them.
/// The Profile exists from the moment an account is seen (role is set then),
/// and personId is filled in when the member claims their node — so role is
/// not coupled to claiming. personId stays null until then.
model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  personId  String?  @unique
  role      UserRole @default(MEMBER)
  createdAt DateTime @default(now())

  person Person? @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([role])
}

/// One contribution from one visitor = one review decision.
///
/// A submission can carry several people (someone plus the parents they typed
/// in), and the admin approves or rejects the bundle as a unit — so the
/// decision lives here on a single row rather than being spread across the
/// PendingEdit rows where it would have to be kept consistent.
model Submission {
  id   String @id @default(cuid())
  kind String // ADD_PEOPLE | EDIT_PERSON

  /// Salted hash of the submitter's IP — never the address itself.
  /// Contributors are anonymous by design; this exists only so a flood of junk
  /// can be rejected as one batch instead of one row at a time.
  submitterHash String?
  submittedAt   DateTime @default(now())

  decision   String? // APPROVED | REJECTED
  reviewedBy String?
  reviewedAt DateTime?
  adminNote  String?

  edits PendingEdit[]

  @@index([decision, submittedAt])
}

/// One person, or one proposed edit, inside a submission.
model PendingEdit {
  id String @id @default(cuid())
  /// Exactly one of personId / marriageId is set: a submission carries either
  /// a person or a marriage.
  personId     String?
  marriageId   String?
  requestType  String // ADD_PERSON | EDIT_PERSON | ADD_MARRIAGE
  submissionId String?

  /// Proposed field values for an EDIT_PERSON request. A correction must not
  /// flip a live approved person to PENDING — that would pull them out of the
  /// public tree while they wait — so the changes wait here until approval.
  payload Json?

  /// Set when the admin resolved this person as someone already in the tree:
  /// the child's link is re-pointed at that person and this duplicate dropped.
  mergedIntoId String?

  /// People already in the tree who look like this one, captured at submit
  /// time so the admin sees the duplicate warning while reviewing.
  duplicateIds String[]

  submittedAt DateTime @default(now())

  person     Person?     @relation(fields: [personId], references: [id], onDelete: Cascade)
  marriage   Marriage?   @relation(fields: [marriageId], references: [id], onDelete: Cascade)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submittedAt])
  @@index([submissionId])
  @@index([marriageId])
}
